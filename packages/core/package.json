{
  "name": "@chladni/core",
  "version": "0.0.0",
  "description": "Voice-reactive Chladni plate engine: audio analysis, plate physics, WebGL2 rendering",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/atharvapatil/chladni-orb.git",
    "directory": "packages/core"
  },
  "homepage": "https://atharvapatil.github.io/chladni-orb/",
  "keywords": [
    "chladni",
    "cymatics",
    "audio-visualizer",
    "voice-ui",
    "webgl2",
    "web-audio"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  }
}
